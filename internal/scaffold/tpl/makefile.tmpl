.PHONY: all build run test clean migrate-up migrate-down setup

APP_NAME={{.AppName}}

all: build

build:
	@echo "Building..."
	@mkdir -p bin
	@go build -o bin/$(APP_NAME) .

run:
	@go run .

dev:
	@astra dev

test:
	@echo "Testing..."
	@go test ./... -v

clean:
	@echo "Cleaning..."
	@rm -rf bin/
	@go clean

setup:
	@echo "Setting up dependencies..."
	@go mod tidy
	@docker-compose up -d
	@$(MAKE) migrate-up

migrate-up:
	@echo "Running migrations..."
	@go run . migrate up

migrate-down:
	@echo "Reverting migrations..."
	@go run . migrate down
